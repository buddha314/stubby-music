{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoalsFile",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Points editors at the generated JSON Schema, for autocomplete.",
      "type": [
        "string",
        "null"
      ]
    },
    "format": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "goals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GoalDefinition"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "format",
    "goals"
  ],
  "$defs": {
    "Condition": {
      "description": "Game states a step can wait for.",
      "oneOf": [
        {
          "description": "Every `configure.cables` patch of a placed machine is made, so its voice sounds.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "machine_configured"
            },
            "machine": {
              "type": "string",
              "x-stubby-ref": "mines"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "machine"
          ]
        },
        {
          "description": "A flowing stream waters a placed tree of this mine.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "tree_watered"
            },
            "mine": {
              "type": "string",
              "x-stubby-ref": "mines"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "mine"
          ]
        },
        {
          "description": "A placed tree of this mine is at this bloom level or above.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "tree_grown"
            },
            "level": {
              "$ref": "#/$defs/GrowthLevel"
            },
            "mine": {
              "type": "string",
              "x-stubby-ref": "mines"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "mine",
            "level"
          ]
        },
        {
          "description": "The player holds at least this many of an item.",
          "type": "object",
          "properties": {
            "item": {
              "type": "string",
              "x-stubby-ref": "items"
            },
            "kind": {
              "type": "string",
              "const": "item_held"
            },
            "quantity": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "item",
            "quantity"
          ]
        }
      ]
    },
    "GoalDefinition": {
      "type": "object",
      "properties": {
        "after": {
          "description": "Goals that must be complete before this one opens.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-stubby-ref": "goals"
        },
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/Condition"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "description": "One line the hub shows under the name.",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "part_of": {
          "description": "The major goal a minor step belongs to. Steps run in file order.",
          "type": [
            "string",
            "null"
          ],
          "x-stubby-ref": "goals"
        },
        "requires": {
          "description": "Items delivered to meet a step. A step has exactly one of `requires` and `condition`.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Stack"
          }
        },
        "scale": {
          "$ref": "#/$defs/Scale"
        },
        "unlocks": {
          "description": "Items discovered in the recipe book when it completes.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-stubby-ref": "items"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "scale"
      ]
    },
    "GrowthLevel": {
      "description": "A growing plant's bloom levels, lowest first (the growth stages of\n`assets/flora/scrub_oak/asset.json`). A plant at a level is at every level below it.",
      "type": "string",
      "enum": [
        "budding",
        "leafing",
        "leafed",
        "full_bloom"
      ]
    },
    "Scale": {
      "description": "A goal's level: a major goal is a set of minor steps.",
      "type": "string",
      "enum": [
        "major",
        "minor"
      ]
    },
    "Stack": {
      "type": "object",
      "properties": {
        "item": {
          "type": "string",
          "x-stubby-ref": "items"
        },
        "quantity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "item",
        "quantity"
      ]
    }
  }
}
