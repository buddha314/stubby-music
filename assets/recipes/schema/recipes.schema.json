{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecipesFile",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Points editors at the generated JSON Schema, for autocomplete.",
      "type": [
        "string",
        "null"
      ]
    },
    "format": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "recipes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RecipeDefinition"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "format",
    "recipes"
  ],
  "$defs": {
    "BpmRange": {
      "description": "An inclusive range of whole beats per minute (tempo clocks are whole multiples of the\n1 BPM master clock).",
      "type": "object",
      "properties": {
        "max": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "min": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ]
    },
    "RecipeDefinition": {
      "type": "object",
      "properties": {
        "bpm": {
          "description": "The tempo it is made at: the bench's clock (the nearest running burbler or flowing\nstream) must be in this range, so the player tunes their streams to what they want\nto make (add-campfire-craft-bench). None: any tempo, or none.",
          "anyOf": [
            {
              "$ref": "#/$defs/BpmRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Stack"
          }
        },
        "name": {
          "type": "string"
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Stack"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "inputs",
        "outputs"
      ]
    },
    "Stack": {
      "type": "object",
      "properties": {
        "item": {
          "type": "string",
          "x-stubby-ref": "items"
        },
        "quantity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "item",
        "quantity"
      ]
    }
  }
}
