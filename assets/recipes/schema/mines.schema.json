{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MinesFile",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Points editors at the generated JSON Schema, for autocomplete.",
      "type": [
        "string",
        "null"
      ]
    },
    "format": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "mines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MineDefinition"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "format",
    "mines"
  ],
  "$defs": {
    "GrowthDefinition": {
      "type": "object",
      "properties": {
        "ease_per_minute": {
          "description": "Growth lost per minute of simulation time without water.",
          "type": "number",
          "format": "float"
        },
        "levels": {
          "description": "Lowest first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/GrowthStage"
          }
        },
        "rise_per_minute": {
          "description": "Growth gained per minute of simulation time while watered.",
          "type": "number",
          "format": "float"
        },
        "water_reach_m": {
          "description": "A flowing stream this close (horizontally, metres) waters the plant.",
          "type": "number",
          "format": "float"
        }
      },
      "additionalProperties": false,
      "required": [
        "levels",
        "water_reach_m",
        "rise_per_minute",
        "ease_per_minute"
      ]
    },
    "GrowthLevel": {
      "description": "A growing plant's bloom levels, lowest first (the growth stages of\n`assets/flora/scrub_oak/asset.json`). A plant at a level is at every level below it.",
      "type": "string",
      "enum": [
        "budding",
        "leafing",
        "leafed",
        "full_bloom"
      ]
    },
    "GrowthStage": {
      "description": "One bloom level: the growth value it starts at and the water that can reach it.",
      "type": "object",
      "properties": {
        "growth": {
          "description": "Growth (0 dormant .. 1 full bloom) at which the plant is at this level.",
          "type": "number",
          "format": "float"
        },
        "level": {
          "$ref": "#/$defs/GrowthLevel"
        },
        "min_clarity": {
          "description": "The least clear water (0 mud .. 1 clear) that grows the plant this far.",
          "type": "number",
          "format": "float"
        }
      },
      "additionalProperties": false,
      "required": [
        "level",
        "growth",
        "min_clarity"
      ]
    },
    "MineDefinition": {
      "type": "object",
      "properties": {
        "growth": {
          "description": "How it grows with water, for a mine that is a plant (a scrub oak).",
          "anyOf": [
            {
              "$ref": "#/$defs/GrowthDefinition"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "produces_resource": {
          "description": "A resource definition ID, not an item ID. Each produced bug is finite.",
          "type": "string",
          "x-stubby-ref": "resources"
        },
        "productivity_factors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProductivityFactor"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "produces_resource"
      ]
    },
    "ProductivityFactor": {
      "type": "string",
      "enum": [
        "water_quality",
        "light_quality"
      ]
    }
  }
}
