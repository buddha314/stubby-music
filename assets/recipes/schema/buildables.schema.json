{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BuildablesFile",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Points editors at the generated JSON Schema, for autocomplete.",
      "type": [
        "string",
        "null"
      ]
    },
    "buildables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BuildableDefinition"
      }
    },
    "format": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "format",
    "buildables"
  ],
  "$defs": {
    "BuildableDefinition": {
      "description": "Something the player builds in the world (not an inventory item), and what one costs.",
      "type": "object",
      "properties": {
        "built_hint": {
          "description": "A line shown once it is built (Satisfactory's hints are the baseline).",
          "type": [
            "string",
            "null"
          ]
        },
        "cost": {
          "description": "Items taken from the inventory for each one built.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Stack"
          }
        },
        "id": {
          "type": "string"
        },
        "model": {
          "description": "The model built and shown as the hologram, under `assets/` (none: laid by its own\nsystem, as streams are).",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "placement": {
          "description": "How its hologram finds its place.",
          "$ref": "#/$defs/Placement",
          "default": "ground"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "cost"
      ]
    },
    "Placement": {
      "description": "How a buildable's hologram finds its place (add-reed-water-purifier D6).",
      "oneOf": [
        {
          "description": "On the ground at the aim.",
          "type": "string",
          "const": "ground"
        },
        {
          "description": "At the aim, or beside the nearest stream within its machine rule's `clock_reach_m`.",
          "type": "string",
          "const": "beside_stream"
        },
        {
          "description": "Across the aimed laid stream segment, square to its flow; nowhere else.",
          "type": "string",
          "const": "across_segment"
        },
        {
          "description": "Laid by its own system (streams).",
          "type": "string",
          "const": "laid"
        }
      ]
    },
    "Stack": {
      "type": "object",
      "properties": {
        "item": {
          "type": "string",
          "x-stubby-ref": "items"
        },
        "quantity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "item",
        "quantity"
      ]
    }
  }
}
