{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResourcesFile",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Points editors at the generated JSON Schema, for autocomplete.",
      "type": [
        "string",
        "null"
      ]
    },
    "format": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ResourceDefinition"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "format",
    "resources"
  ],
  "$defs": {
    "ReplenishmentPolicy": {
      "description": "Finite availability periods; independent of infinite mine production.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "never"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "after"
            },
            "seconds": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "seconds"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "next_night"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "ResourceDefinition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "replenishment": {
          "$ref": "#/$defs/ReplenishmentPolicy"
        },
        "yields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Stack"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "yields"
      ]
    },
    "Stack": {
      "type": "object",
      "properties": {
        "item": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "item",
        "quantity"
      ]
    }
  }
}
